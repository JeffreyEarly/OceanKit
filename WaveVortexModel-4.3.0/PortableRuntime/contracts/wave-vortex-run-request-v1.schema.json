{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wavevortexmodel.org/contracts/wave-vortex-run-request-v1.schema.json",
  "title": "WaveVortex portable run request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaIdentifier",
    "schemaVersion",
    "modelFiles",
    "integration",
    "output",
    "execution",
    "report"
  ],
  "properties": {
    "schemaIdentifier": {
      "const": "wave-vortex-run-request-v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "modelFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "integration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "finalTime", "initialStep"],
          "properties": {
            "method": {"const": "fixed-rk4"},
            "finalTime": {"type": "number"},
            "initialStep": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "finalTime",
            "initialStep",
            "maximumStep",
            "relativeTolerance",
            "absoluteToleranceScale"
          ],
          "properties": {
            "method": {"const": "adaptive-rk23"},
            "finalTime": {"type": "number"},
            "initialStep": {"type": "number", "exclusiveMinimum": 0},
            "maximumStep": {"type": "number", "exclusiveMinimum": 0},
            "relativeTolerance": {"type": "number", "exclusiveMinimum": 0},
            "absoluteToleranceScale": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "destinations"],
      "properties": {
        "policy": {
          "enum": ["create", "replace", "append"]
        },
        "destinations": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fftProvider", "threads"],
      "properties": {
        "fftProvider": {
          "enum": ["native-fftw", "reference"]
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "report": {
      "type": "string",
      "minLength": 1
    }
  }
}
