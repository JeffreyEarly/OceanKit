    "matlabKernelParity": ["TestBarotropicQGCompiledKernel/matlabAuthoritativeParity"],
    "portableCpp": [
      "barotropic-qg-integration",
      "barotropic-qg-forcing",
      "barotropic-qg-model-output",
      "barotropic-qg-native-fftw"
    ],
    "constantStratificationRegression": [
      "TestPortableRuntimeCompatibility/matlabModelGraphRoundTripsThroughStandalone",
      "TestPortableRunRequestWriter/writesEveryAcceptedSchemaFormDeterministically"
    ]
